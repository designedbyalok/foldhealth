{
  "name": "foldhealth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run build:report-viewer && vite",
    "build": "bun run build:report-viewer && vite build",
    "build:report-viewer": "vite build -c vite.report-viewer.config.js",
    "dev:patient": "vite -c vite.patient.config.js",
    "build:patient": "vite build -c vite.patient.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs": "cd docs && mint dev",
    "docs:build": "cd docs && mint broken-links",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "seed": "bun run scripts/seed.js",
    "sync:cvx": "node scripts/sync-cvx.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "guardrails": "node scripts/ds-guardrails.mjs",
    "receiver-audit": "node scripts/receiver-audit.mjs --all",
    "check:no-undef": "node scripts/check-no-undef.mjs",
    "prepare": "husky",
    "doctor": "bunx react-doctor@latest"
  },
  "lint-staged": {
    "*.{js,jsx,css}": "bun scripts/ds-guardrails.mjs --staged",
    "*.{js,jsx}": [
      "bun scripts/receiver-audit.mjs --staged",
      "bun scripts/check-no-undef.mjs"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "2.1.8",
    "@iconify/react": "^6.0.3",
    "@medv/finder": "^4.0.2",
    "@preact/signals": "^2.11.4",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/events-service": "^4.9.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.9.1",
    "@sentry/react": "11",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@uiw/react-signature": "^1.3.5",
    "@usewaypoint/email-builder": "^0.0.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "1.0.3",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.12.0",
    "@zumer/snapdom": "^3.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "jspdf": "^4.2.1",
    "konva": "^10.9.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-grid-layout": "^2.3.0",
    "react-joyride": "^3.2.0",
    "react-konva": "^19.3.2",
    "react-querybuilder": "^8.26.0",
    "react-rnd": "^10.5.3",
    "recharts": "^3.10.1",
    "resend": "^6.35.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "1.0.5",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-onboarding": "10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "chromatic": "^18.13.6",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "17",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react-doctor": "^0.9.18",
    "storybook": "10.6.5",
    "stylelint": "17.16.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "aria-query": "^5.3.2"
  }
}
