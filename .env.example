# Copy to .env for local dev, and set the same keys in the Claude Code cloud
# environment dialog (claude.ai/code → environment → Environment variables) so
# remote sessions can run the app. Never commit real values; .env is gitignored.

# --- Client (VITE_*, bundled into the browser build) -------------------------
# Safe to expose: Supabase enforces access with row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# openFDA drug lookups (free key: https://open.fda.gov/apis/authentication/)
VITE_OPENFDA_API_KEY=your-openfda-key

# Dev-mode auto-login for the "Continue without login" button.
# Signs in as the seeded demo user; required to use the app without SSO.
VITE_DEV_LOGIN_EMAIL=demo@fold.health
VITE_DEV_LOGIN_PASSWORD=your-demo-user-password

# --- Server-only (never exposed to the browser) ------------------------------
# Only needed to run seed/migration scripts, not to run the dev server.
# Prefer the cloud "API credentials" section over plain env vars for these.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-supabase-db-password

# WHO ICD-11 API proxy (register free at https://icd.who.int/icdapi).
ICD_CLIENT_ID=your-icd-client-id
ICD_CLIENT_SECRET=your-icd-client-secret
# Optional overrides (defaults target the WHO cloud):
# ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
# ICD_API_BASE=https://id.who.int
# ICD_RELEASE=2024-01
# ICD_LINEARIZATION=mms
# ICD_LANGUAGE=en
