# Copy to .env for local dev, and set the same keys in the Claude Code cloud
# environment dialog (claude.ai/code → environment → Environment variables) so
# remote sessions can run the app. Never commit real values; .env is gitignored.

# --- Client (VITE_*, bundled into the browser build) -------------------------
# Safe to expose: Supabase enforces access with row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# openFDA drug lookups (free key: https://open.fda.gov/apis/authentication/)
VITE_OPENFDA_API_KEY=your-openfda-key

# Dev-mode auto-login for the "Continue without login" button.
# Signs in as the seeded demo user; required to use the app without SSO.
VITE_DEV_LOGIN_EMAIL=demo@fold.health
VITE_DEV_LOGIN_PASSWORD=your-demo-user-password

# --- Server-only (never exposed to the browser) ------------------------------
# Only needed to run seed/migration scripts, not to run the dev server.
# Prefer the cloud "API credentials" section over plain env vars for these.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Google AI (Gemini) — powers the care plan "Summarize" button via the
# /api/care-plan-summary proxy. Get a key at https://aistudio.google.com/apikey.
# Set this in Vercel (Production + Preview + Development) for the deployed app.
# Server-side only (api/care-plan-summary, api/pop-group-rule-from-nl).
# Local: copy to .env. Production: Vercel → foldhealth → Settings → Environment Variables,
# name GOOGLE_AI_API_KEY, enable Production (and Preview if needed), then Redeploy.
GOOGLE_AI_API_KEY=your-google-ai-key
# Optional: override the model (defaults to gemini-3.8-flash).
# GOOGLE_AI_MODEL=gemini-3.8-flash
# Optional: comma-separated fallbacks when the primary model is overloaded (503/429).
# GOOGLE_AI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# WHO ICD-11 API proxy (register free at https://icd.who.int/icdapi).
ICD_CLIENT_ID=your-icd-client-id
ICD_CLIENT_SECRET=your-icd-client-secret
# Optional overrides (defaults target the WHO cloud):
# ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
# ICD_API_BASE=https://id.who.int
# ICD_RELEASE=2024-01
# ICD_LINEARIZATION=mms
# ICD_LANGUAGE=en

# Non-drug (SNOMED CT) allergen lookup behind /api/reference/allergies/substances.
# Server-side only — no VITE_ prefix, so it never reaches the browser bundle.
# Free personal key from https://uts.nlm.nih.gov/uts/profile. Without it the
# route returns no matches and the drawer still searches drug allergies
# (RxNorm, public and keyless) from the client.
UMLS_API_KEY=

# Pexels photo search for the Employer Impact report cover (/api/pexels-search).
# Server-side only, photos only. Free key: https://www.pexels.com/api/
# Also set it in Vercel (Production + Preview) for the deployed app.
PEXEL_API_KEY=your-pexels-api-key
