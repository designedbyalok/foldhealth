# Impeccable — the Claude Code skill lives under .claude/skills/impeccable and is
# shared. Its parallel mirrors for other tools (Codex CLI, Copilot) and its
# session cache are not, so we don't pollute .github/ or add megabytes of
# duplicate skill files.
.agents/
.codex/
.github/skills/
.github/agents/
.github/hooks/
.impeccable/hook.cache.json

# Supabase CLI working directory (auto-populated by `supabase link`)
supabase/.temp/
