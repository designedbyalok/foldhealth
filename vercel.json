{
  "framework": "vite",
  "installCommand": "bunx bun@1.4.2 install",
  "buildCommand": "bunx bun@1.4.2 run build",
  "redirects": [
    {
      "source": "/docs/",
      "destination": "/docs/introduction",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/icd-search",
      "destination": "/api/lookup?route=icd-search"
    },
    {
      "source": "/api/reference/immunizations",
      "destination": "/api/lookup?route=immunizations"
    },
    {
      "source": "/api/reference/allergies/substances",
      "destination": "/api/lookup?route=allergy-substances"
    },
    {
      "source": "/api/send-test-email",
      "destination": "/api/email?route=send-test-email"
    },
    {
      "source": "/api/send-report-email",
      "destination": "/api/email?route=send-report-email"
    },
    {
      "source": "/api/referral-email",
      "destination": "/api/email?route=referral-email"
    },
    {
      "source": "/s/:section",
      "destination": "/api/share?s=:section"
    },
    {
      "source": "/docs",
      "destination": "https://fold-ab931789.subdirectory-docs.mintlify.me/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://fold-ab931789.subdirectory-docs.mintlify.me/docs/:match*"
    }
  ]
}
