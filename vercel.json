{
  "framework": "vite",
  "installCommand": "bunx bun@1.4.2 install",
  "buildCommand": "bunx bun@1.4.2 run build",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/docs/",
      "destination": "/docs/introduction",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/icd-search",
      "destination": "/api/lookup?route=icd-search"
    },
    {
      "source": "/api/reference/immunizations",
      "destination": "/api/lookup?route=immunizations"
    },
    {
      "source": "/api/reference/allergies/substances",
      "destination": "/api/lookup?route=allergy-substances"
    },
    {
      "source": "/api/patient-media-url",
      "destination": "/api/lookup?route=patient-media-url"
    },
    {
      "source": "/api/send-test-email",
      "destination": "/api/email?route=send-test-email"
    },
    {
      "source": "/api/send-report-email",
      "destination": "/api/email?route=send-report-email"
    },
    {
      "source": "/api/referral-email",
      "destination": "/api/email?route=referral-email"
    },
    {
      "source": "/api/password-reset",
      "destination": "/api/account?route=password-reset"
    },
    {
      "source": "/api/account-unlock",
      "destination": "/api/account?route=account-unlock"
    },
    {
      "source": "/api/security-email-dispatch",
      "destination": "/api/account?route=security-email-dispatch"
    },
    {
      "source": "/api/auth-activity",
      "destination": "/api/account?route=auth-activity"
    },
    {
      "source": "/api/patient-invite",
      "destination": "/api/account?route=patient-invite"
    },
    {
      "source": "/api/pop-group-rule-from-nl",
      "destination": "/api/ai?route=pop-group-rule-from-nl"
    },
    {
      "source": "/api/care-plan-summary",
      "destination": "/api/ai?route=care-plan-summary"
    },
    {
      "source": "/api/care-plan-template-draft",
      "destination": "/api/ai?route=care-plan-template-draft"
    },
    {
      "source": "/api/care-plan-individualized",
      "destination": "/api/ai?route=care-plan-individualized"
    },
    {
      "source": "/api/patient-recap-summary",
      "destination": "/api/ai?route=patient-recap-summary"
    },
    {
      "source": "/api/template-optimization",
      "destination": "/api/ai?route=template-optimization"
    },
    {
      "source": "/api/clinical-protocol-parse",
      "destination": "/api/ai?route=clinical-protocol-parse"
    },
    {
      "source": "/s/:section",
      "destination": "/api/share?s=:section"
    },
    {
      "source": "/docs",
      "destination": "https://fold-ab931789.subdirectory-docs.mintlify.me/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://fold-ab931789.subdirectory-docs.mintlify.me/docs/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=()"
        }
      ]
    }
  ]
}
